// =============================================================================================
// Company Internal Chat — database schema
// =============================================================================================
//
// This file implements the entity design in docs/02-database.md §2. That document is the source
// of truth for every column, constraint, index and referential action below; where a decision
// looks arbitrary, its reasoning is there and is summarised in a comment here.
//
// SAFETY (docs/02-database.md §0): this project touches exactly one database —
// `company_chat_db`, which already exists — through a dedicated non-superuser role. The schema
// is only ever migrated FORWARD. `prisma migrate reset`, `db push --force-reset`,
// `DROP DATABASE`, `DROP SCHEMA` and every other destructive reset are prohibited outright.
//
// Conventions applied throughout:
//   - uuid primary keys, generated application-side so an id exists before the write
//   - every timestamp `timestamptz`, stored UTC, formatted for display in the browser (A-05)
//   - containers cascade, authorship does not: deleting a conversation removes its messages,
//     but deleting a user never removes the messages they wrote (docs/02-database.md §4)

generator client {
  provider     = "prisma-client"
  // Generated TypeScript, not committed: `prisma generate` reproduces it, and both
  // `npm run build` and `postinstall` run that. The entry point is
  // prisma/generated/client.ts, imported only by lib/db/prisma.ts.
  output       = "./generated"
  // CommonJS output. The custom server (D-09) is compiled by plain `tsc` to CommonJS, and the
  // ESM default emits `import.meta.url`, which cannot be expressed in a CommonJS file — the
  // compiled server then fails to start. Next.js consumes either format happily.
  moduleFormat = "cjs"
}

// Prisma 7 takes the connection URL from prisma.config.ts for migration commands, and from the
// driver adapter passed to PrismaClient at runtime (see lib/db/prisma.ts). No connection string,
// host, port, user or password appears in this file or anywhere else in tracked source.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------------------------

enum ConversationType {
  DIRECT
  GROUP
}

enum MemberRole {
  OWNER
  MEMBER
}

enum MessageType {
  TEXT
  FILE
  SYSTEM
}

/// What a mention points at (Batch 1.7).
///
/// Two values rather than a nullable user id alone, because "@everyone" is not a user and must
/// never be stored as though it were one: its audience is whoever is an active member AT THE
/// MOMENT IT IS READ, which is a question answered from the membership table and not from a list
/// frozen at send time.
enum MentionKind {
  USER
  EVERYONE
}

enum AttachmentStatus {
  PENDING
  READY
  FAILED
  /// Delete-for-everyone removed the bytes. The row is kept so the message that owned it stays
  /// referentially intact and so a download can be refused deliberately rather than by absence.
  DELETED
}

// ---------------------------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------------------------

/// An application user. Entirely unrelated to the PostgreSQL role the application connects as.
///
/// D-02: display names are NOT unique. Two rows may hold the same name and are two different
/// people. `normalizedName` therefore carries a PLAIN, NON-UNIQUE index and exists for directory
/// search and ordering only — it is not an identifier, and no query anywhere may resolve a user
/// by name. The only identifier is `id`.
///
/// Real authentication later adds `externalId varchar UNIQUE NULL` here and changes nothing else
/// in the schema — that is why identity lives in its own entity rather than being denormalised
/// onto messages.
model User {
  id             String   @id @default(uuid(4)) @db.Uuid
  /// As entered, trimmed.
  displayName    String   @db.VarChar(64)
  /// Lower-cased, whitespace-collapsed. Search and sort only — never an identifier.
  normalizedName String   @db.VarChar(64)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt     DateTime @default(now()) @db.Timestamptz(3)
  /// Lets a name be retired without deleting message history. Deleting a User is not an
  /// operation the application offers; this is the retirement path.
  isActive       Boolean  @default(true)

  sessions             Session[]
  devices              Device[]
  memberships          ConversationMember[]
  messages             Message[]
  attachments          Attachment[]
  createdConversations Conversation[]       @relation("ConversationCreatedBy")
  reactions            MessageReaction[]
  hiddenMessages       MessageHide[]
  mentionedIn          MessageMention[]    @relation("MessageMentionTarget")
  pinnedMessages       Message[]            @relation("MessagePinnedBy")
  deletedMessages      Message[]            @relation("MessageDeletedBy")

  @@index([normalizedName])
  @@index([lastSeenAt])
}

/// One row per browser that is currently signed in. Answers "is this browser currently active?".
///
/// Temporary authentication state that owns no application data (D-14): the foreign keys run
/// Session → User and Session → Device and never the reverse, so expiring a session can delete
/// exactly one row and nothing else. Only the SHA-256 hash of the cookie token is stored; the raw
/// token never is.
model Session {
  id         String   @id @default(uuid(4)) @db.Uuid
  userId     String   @db.Uuid
  /// The company computer this session was issued for (docs/12-admin-device-identity.md).
  ///
  /// Not decoration and not diagnostics. Identity is anchored to a device, so a session must be
  /// traceable back to the device that produced it — otherwise reassigning that computer to a
  /// new employee cannot revoke the previous employee's still-valid session cookie, and the old
  /// identity keeps resolving. Nullable so a session outlives a deleted device row rather than
  /// disappearing with it.
  deviceId   String?  @db.Uuid
  /// SHA-256 hex digest of the opaque session cookie token.
  tokenHash  String   @unique @db.Char(64)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  /// Explicit expiry, enforced on every lookup and slid forward on activity (D-04, 24h idle).
  expiresAt  DateTime @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  /// Diagnostics only. See Q-11 before adding a client IP here.
  userAgent  String?  @db.VarChar(255)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@index([deviceId])
}

/// A company computer known to the system, and the employee currently assigned to it.
///
/// This is the ONLY way an identity comes into existence (docs/12-admin-device-identity.md).
/// Employees do not create, choose, change or clear their own identity: an administrator assigns
/// a computer to a named employee, and the browser on that computer is thereafter recognised as
/// that `User`. The row therefore answers two questions at once — "which physical machine is
/// this?" (`label`) and "whose is it right now?" (`userId`).
///
/// Lifecycle:
///
///   assigned    userId set, tokenHash NULL, enrollmentTokenHash set  → awaiting setup
///   enrolled    tokenHash set, enrollmentTokenHash NULL              → employee is recognised
///   reassigned  userId points at a NEW User; tokenHash UNCHANGED     → recognised immediately
///   re-enrolled tokenHash cleared, a fresh enrollment code issued    → awaiting setup again
///   revoked     revokedAt set                                        → resolves no more
///
/// Reassignment repoints `userId` at a newly created `User` and never renames the old one. The
/// previous employee's `User`, memberships, conversations and messages are untouched (D-14).
///
/// Reassignment deliberately does NOT clear `tokenHash`: the computer is already enrolled, and
/// making an ordinary staff change require somebody to walk to the machine with a code would
/// push admins towards keeping codes lying around. What it does instead is delete every
/// `Session` issued for this device, so the previous employee's session cookie stops resolving
/// at once. Re-enrollment is for a machine whose browser identity was actually lost — a
/// reimaged PC, cleared site data, a replaced browser profile.
///
/// Resolution rule, unchanged from D-13: a device resolves ONLY when `tokenHash IS NOT NULL AND
/// revokedAt IS NULL AND expiresAt > now()`. Checking the row's mere existence is the bug to
/// avoid. The device cookie is still a bearer token, not authentication — it grants no privilege
/// and relaxes no authorization check (R-16).
model Device {
  id                  String    @id @default(uuid(4)) @db.Uuid
  /// The currently assigned employee. Repointed by an admin reassignment, never renamed.
  userId              String    @db.Uuid
  /// Admin-facing name of the physical computer, e.g. "Reception PC" or "DESK-014". Unique, so
  /// two machines cannot be confused for one another in the admin list.
  label               String    @unique @db.VarChar(64)
  /// SHA-256 hex digest of the opaque device cookie token.
  ///
  /// NULL until the computer is enrolled, and NULL again after a reassignment: the assignment
  /// exists before any browser has been handed a cookie for it.
  tokenHash           String?   @unique @db.Char(64)
  /// SHA-256 hex digest of the one-time enrollment code. Cleared the moment it is redeemed.
  enrollmentTokenHash String?   @unique @db.Char(64)
  enrollmentExpiresAt DateTime? @db.Timestamptz(3)
  /// When the current assignment was made by an administrator.
  assignedAt          DateTime  @default(now()) @db.Timestamptz(3)
  /// When the current assignment was redeemed on the computer itself.
  enrolledAt          DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  /// now + DEVICE_ID_TTL_DAYS (default 90), renewed on use.
  expiresAt           DateTime  @db.Timestamptz(3)
  lastSeenAt          DateTime  @default(now()) @db.Timestamptz(3)
  /// Set server-side when an administrator retires the computer. A revoked device never resolves
  /// again, so a copied cookie is useless — which is why this cannot be a browser-side deletion.
  revokedAt           DateTime? @db.Timestamptz(3)
  userAgent           String?   @db.VarChar(255)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------------------------
// Conversations
// ---------------------------------------------------------------------------------------------

model Conversation {
  id            String           @id @default(uuid(4)) @db.Uuid
  type          ConversationType
  /// Groups only; null for direct conversations.
  name          String?          @db.VarChar(120)
  /// DIRECT only: the two member ids sorted and joined, e.g. "<uuid>:<uuid>".
  ///
  /// "At most one direct conversation per pair" cannot be expressed as a constraint over the
  /// membership table, so it is materialised here with a unique index. The database enforces it
  /// instead of application code racing itself into duplicate pair conversations.
  directKey     String?          @unique @db.VarChar(73)
  createdById   String?          @db.Uuid
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  /// The one deliberate denormalisation: ordering the sidebar otherwise needs a correlated
  /// max-per-conversation subquery on the largest table on every load. Written inside the same
  /// transaction as the message insert, so it cannot drift (docs/02-database.md §5).
  lastMessageAt DateTime?        @db.Timestamptz(3)

  createdBy   User?                @relation("ConversationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  members     ConversationMember[]
  messages    Message[]
  attachments Attachment[]

  @@index([lastMessageAt(sort: Desc)])
}

/// Membership of one user in one conversation.
///
/// Removal sets `leftAt` rather than deleting the row: it preserves who was present when, and
/// keeps read state meaningful if the person is re-added. **Authorization checks must test
/// `leftAt IS NULL`**, not merely that the row exists — the most likely place for an
/// access-control bug in this schema.
///
/// `joinedAt` is a SECURITY COLUMN, not a timestamp (D-03). A member sees only messages with
/// `createdAt >= joinedAt`, so this value bounds what history is readable — in message queries,
/// in file downloads (via the attachment's message), and in list previews and unread counts
/// alike. It is written by the server only, never accepted from a request, and is never editable
/// through the API. Re-adding a removed member sets it to the new join time and clears `leftAt`.
model ConversationMember {
  id                String     @id @default(uuid(4)) @db.Uuid
  conversationId    String     @db.Uuid
  userId            String     @db.Uuid
  /// Direct conversations: both members are MEMBER.
  role              MemberRole @default(MEMBER)
  joinedAt          DateTime   @default(now()) @db.Timestamptz(3)
  /// Non-null means removed or left. The row is kept.
  leftAt            DateTime?  @db.Timestamptz(3)
  /// Drives the unread count. Deliberately a plain column rather than a foreign key: it is a
  /// read marker, and a cascade or restriction from Message onto membership is not wanted.
  lastReadMessageId String?    @db.Uuid
  lastReadAt        DateTime?  @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  /// Every authorization check uses this index, so it is not optional.
  @@index([userId, conversationId])
}

// ---------------------------------------------------------------------------------------------
// Messages & attachments
// ---------------------------------------------------------------------------------------------

model Message {
  id              String      @id @default(uuid(4)) @db.Uuid
  conversationId  String      @db.Uuid
  /// SET NULL on user delete — never cascade a person's messages away. The UI renders the
  /// author as "Unknown user".
  senderId        String?     @db.Uuid
  type            MessageType
  /// Required for TEXT, an optional caption for FILE, the rendered text for SYSTEM.
  body            String?
  /// Browser-generated idempotency key. Phase 4 uses it so that a send retried after a dropped
  /// acknowledgement collides with the existing row instead of inserting a second message.
  clientMessageId String      @db.Uuid
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)

  /// The message this one replies to (Batch 1). Always in the SAME conversation — enforced by
  /// the service, because a foreign key cannot express "and the same conversationId".
  ///
  /// `SET NULL` rather than `Cascade`: a reply is a message in its own right and must survive
  /// its parent. Delete-for-everyone is a tombstone and does not remove the row at all, so this
  /// fires only when a whole conversation is deleted — at which point the reply is going too.
  replyToId   String?   @db.Uuid
  /// Marks a message that was forwarded from somewhere else.
  ///
  /// A flag, not a link. Recording WHICH message it came from would let a recipient learn that a
  /// conversation they cannot see exists and who wrote in it, and would tie the forwarded copy's
  /// lifecycle to a message in another conversation — the exact coupling that makes deleting an
  /// original break a copy. The copy is independent by construction.
  isForwarded Boolean   @default(false)
  /// When the sender last edited this message's text (Batch 1.1). Null means never edited, which
  /// is exactly what the interface checks before showing an "edited" label.
  ///
  /// THERE IS DELIBERATELY NO `editedById`. Only the original sender may edit their own message,
  /// so the editor is always `senderId` — a second column would record a fact already stored, and
  /// the two could then disagree. It is not indexed either: nothing queries by it, every read
  /// merely selects it.
  ///
  /// Editing changes `body` and this column and NOTHING else: not `createdAt`, not the sender, not
  /// the conversation, not the reply target, not the forward flag, and not
  /// `Conversation.lastMessageAt` — an edit is not a new message and must not behave like one.
  editedAt    DateTime? @db.Timestamptz(3)
  /// Non-null when this message is pinned in its conversation. Pinning is conversation-level and
  /// visible to every member, so it lives on the message rather than per user.
  pinnedAt    DateTime? @db.Timestamptz(3)
  pinnedById  String?   @db.Uuid
  /// Delete-for-everyone. The row is KEPT and `body` is cleared: replies, ordering and history
  /// stay intact, and the interface renders a tombstone. Physical deletion of a message happens
  /// only when its conversation is deleted.
  deletedAt   DateTime? @db.Timestamptz(3)
  deletedById String?   @db.Uuid

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?             @relation(fields: [senderId], references: [id], onDelete: SetNull)
  attachment   Attachment?
  replyTo      Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]         @relation("MessageReplies")
  pinnedBy     User?             @relation("MessagePinnedBy", fields: [pinnedById], references: [id], onDelete: SetNull)
  deletedBy    User?             @relation("MessageDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  reactions    MessageReaction[]
  hiddenFor    MessageHide[]
  mentions     MessageMention[]

  /// The duplicate-send guard. SYSTEM messages have a null `senderId`; PostgreSQL treats NULLs
  /// as distinct in a unique index, so server-written messages never collide with each other.
  @@unique([senderId, clientMessageId])
  /// History pagination and the "latest message" read. Keyset pagination on (createdAt, id)
  /// rather than OFFSET: correct under concurrent inserts, and it does not degrade as history
  /// grows.
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  /// The pinned-message panel reads this. Partial in spirit — most rows have a null `pinnedAt`.
  @@index([conversationId, pinnedAt(sort: Desc)])
  /// Reply previews are loaded by parent id when a page of history is rendered.
  @@index([replyToId])
}

/// File metadata. Phase 3 creates the table only — no upload, download or storage exists until
/// Phase 7, and no file bytes are ever stored in the database.
///
/// `conversationId` is not duplicated data: an attachment exists before its message does, so its
/// conversation cannot be derived through `messageId` at the moment the upload is authorized.
///
/// Download authorization must not stop at `conversationId`. Under D-03 it must also load the
/// linked message and confirm `Message.createdAt >= member.joinedAt`, or a newly added member
/// could pull every file ever shared in the group by asking for the file instead of the message.
model Attachment {
  id               String           @id @default(uuid(4)) @db.Uuid
  conversationId   String           @db.Uuid
  /// Null between upload and message creation. Unique: one attachment per message in v1 (A-07).
  messageId        String?          @unique @db.Uuid
  uploaderId       String?          @db.Uuid
  /// As supplied by the client. Sanitized at render and at download; never used as a path.
  originalFilename String           @db.VarChar(255)
  /// Server-generated relative path, e.g. "2026/08/<uuid>.bin". Never client-influenced.
  storageKey       String           @unique @db.VarChar(255)
  /// Measured server-side, never taken from the client. BigInt deliberately: MAX_FILE_SIZE is
  /// 500 MB and configurable upward, so a 32-bit column would be an avoidable ceiling.
  byteSize         BigInt
  /// Detected server-side from the file's leading bytes, never taken from the client.
  mimeType         String           @db.VarChar(127)
  /// Validated against the configured allowlist.
  extension        String           @db.VarChar(16)
  checksumSha256   String?          @db.Char(64)
  status           AttachmentStatus @default(PENDING)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message?     @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploader     User?        @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  /// The abandoned-upload sweep (Phase 7) reads this.
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------------------------
// Message actions (Batch 1)
// ---------------------------------------------------------------------------------------------

/// One person's reaction to one message.
///
/// ONE REACTION PER PERSON PER MESSAGE, enforced by `@@unique([messageId, userId])` rather than
/// by application code. Two consequences follow, both deliberate:
///
///   - A double-tap cannot create two identical rows, whatever the client does or how often a
///     request is retried.
///   - Picking a different emoji REPLACES the existing one, because there is nowhere to put a
///     second. The service does that as an upsert, so changing a reaction is one round trip and
///     cannot leave a person with two.
///
/// The emoji is stored as text rather than as an enum so the palette can grow without a
/// migration. The server still accepts only values from its own allow-list — an open column is
/// not an open API.
model MessageReaction {
  id        String   @id @default(uuid(4)) @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  /// A single emoji from the server's allow-list. VarChar(32) because one emoji can be several
  /// code points (skin tones, ZWJ sequences) and 32 bytes covers those without inviting prose.
  emoji     String   @db.VarChar(32)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Both the uniqueness rule and the lookup index for rendering a message's reactions.
  @@unique([messageId, userId])
  @@index([messageId])
}

/// One mention inside one message (Batch 1.7).
///
/// WHY THIS IS A TABLE AND NOT A SCAN OF THE TEXT. A mention has to survive things the text
/// cannot: display names change, two colleagues share a name (D-02), names contain spaces, and
/// anybody can type an `@` that means nothing. Searching the body for "@Nilesh" answers none of
/// those, and would make who-gets-notified depend on a string comparison against a mutable
/// column. Identity here is the `User` id, exactly as everywhere else in this schema.
///
/// ONE ROW PER OCCURRENCE, not per person. "@Nilesh please ask @Nilesh" stores two rows so both
/// are highlighted where they were written; the notification layer reduces them to one recipient.
/// That is a presentation fact and a delivery fact, and they are deliberately not the same fact.
///
/// THE OFFSETS ARE A HALF-OPEN RANGE over the message body, `[startOffset, endOffset)`, in UTF-16
/// code units — the units `String.prototype.slice` uses, since the body is only ever sliced in
/// JavaScript. They are what make rendering exact and rename-proof: the highlight is the span
/// that was written, so a later rename changes nobody's historical text. The server validates
/// every range against the body before it is stored, so a stored range always describes the
/// message it belongs to.
///
/// NO LABEL COLUMN, deliberately. The text is already in `Message.body` at exactly these offsets,
/// so a label would be a second copy that could disagree with the first.
///
/// NO `createdAt`. A mention has no lifetime of its own: it is written with its message, replaced
/// wholesale when the message is edited, and removed when the message is deleted for everyone.
model MessageMention {
  id        String      @id @default(uuid(4)) @db.Uuid
  messageId String      @db.Uuid
  kind      MentionKind
  /// The person mentioned. NULL exactly when `kind` is `EVERYONE`, which names no one row.
  ///
  /// Cascades: a mention is meaningless once the person is gone, and removing the row leaves the
  /// message's own text untouched — the highlight goes, the sentence stays. Deleting a `User` is
  /// not something the application offers, so this is a safety net rather than a routine path.
  mentionedUserId String? @db.Uuid
  /// Inclusive start of `@…` in `Message.body`.
  startOffset     Int
  /// Exclusive end.
  endOffset       Int

  message       Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mentionedUser User?   @relation("MessageMentionTarget", fields: [mentionedUserId], references: [id], onDelete: Cascade)

  /// Two things at once, which is why it is the only index on this table.
  ///
  /// As a CONSTRAINT it makes duplicate mention metadata unrepresentable: two rows cannot claim
  /// the same span of the same message, so a replayed or doubled payload cannot produce them.
  ///
  /// As an INDEX its leading column is `messageId`, which is the only way anything reads this
  /// table — mentions are loaded with the message that owns them, never on their own.
  ///
  /// `mentionedUserId` is deliberately NOT indexed. Nothing queries "messages that mention me";
  /// if that is ever built, the index arrives with the query that needs it rather than ahead of it.
  @@unique([messageId, startOffset])
}

/// "Delete for me": one person has hidden one message from their own view.
///
/// A separate table rather than a column, because the state belongs to the (message, person)
/// pair and not to the message. The shared row is never touched — everyone else goes on seeing
/// the message, which is the entire difference between this and delete-for-everyone.
///
/// Cascades from both sides: hiding is meaningless once either the message or the person is
/// gone, and it owns nothing that should outlive them.
model MessageHide {
  id        String   @id @default(uuid(4)) @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  /// Every history read filters by the reader, so this is the shape that query needs.
  @@index([userId, messageId])
}
