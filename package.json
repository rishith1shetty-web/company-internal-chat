{
  "name": "company-internal-chat",
  "version": "0.1.0",
  "private": true,
  "description": "Company Internal Chat & File Transfer System - privately hosted chat and file transfer for internal company use",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore \".next/**\" --ignore \"dist/**\" --ignore \"app/**\" --ignore \"components/**\" server.ts",
    "build": "prisma generate && next build && tsc -p tsconfig.server.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p desktop/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop:dev": "npm run desktop:build && electron dist-desktop/main.js",
    "desktop:build": "tsc -p desktop/tsconfig.json && node scripts/desktop-assets.mjs",
    "desktop:package": "npm run desktop:build && electron-builder --win --publish never",
    "desktop:package:win": "npm run desktop:build && electron-builder --win nsis portable --publish never",
    "db:generate": "prisma generate",
    "db:check": "tsx scripts/db-check.ts",
    "db:audit": "tsx scripts/db-audit.ts",
    "db:status": "prisma migrate status",
    "db:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "zod": "4.5.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "postcss": "^8.5.26",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "4.1.11"
  },
  "main": "dist-desktop/main.js",
  "build": {
    "appId": "com.risingpathrecruiters.chat",
    "productName": "Rising Path Recruiters Chat",
    "copyright": "Rising Path Recruiters",
    "directories": {
      "output": "release",
      "buildResources": "desktop/assets"
    },
    "files": [
      "dist-desktop/**/*",
      "!node_modules/**/*",
      "!**/*.map"
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "desktop/assets/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rising Path Recruiters Chat",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Rising Path Recruiters Chat Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "Rising Path Recruiters Chat ${version} Portable.${ext}"
    }
  }
}
