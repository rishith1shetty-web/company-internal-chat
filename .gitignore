# Dependencies
/node_modules
/.pnp
.pnp.*

# Next.js build output
/.next
/out

# Custom server build output (tsc -p tsconfig.server.json)
/dist

# Desktop client build output (tsc -p desktop/tsconfig.json) and its installers.
/dist-desktop
/release

# Desktop build assets. Generated from public/brand/rising-path-mark.png by
# scripts/desktop-assets.mjs, so they are build output rather than source — the logo itself is
# tracked, its derived icon sizes are not.
/desktop/assets

# Generated Prisma client. Reproduced by `prisma generate` (which `npm run build` and
# `postinstall` both run), so it is a build artifact rather than source.
/prisma/generated

# Environment files — NEVER commit real configuration or credentials.
# Only .env.example is tracked.
.env
.env.*
!.env.example

# Uploaded files (company data — never enters version control, CLAUDE.md §15)
/uploads
/var
/storage

# Certificates and private keys.
#
# The real PKI lives OUTSIDE this repository (C:\company-chat-pki, docs/20-phase-10-deployment.md
# §20), so nothing here should ever match. These rules exist so that a key copied into the working
# tree for convenience cannot be committed by accident — a private key in Git history is not
# something you can take back (CLAUDE.md §15).
*.key
*.pem
*.crt
*.cer
*.pfx
*.p12
*.csr
/deploy/certs

# Logs
*.log
npm-debug.log*
logs

# Test / coverage output
/coverage

# TypeScript incremental build info
*.tsbuildinfo

# Locally installed Claude Code tooling (skills, agents, local settings).
# Kept on the developer's machine, never tracked: it is tooling, not application source,
# and it is not needed to build, run or deploy the application.
/.claude

# Editor / OS noise
.DS_Store
Thumbs.db
.idea
.vscode/*
!.vscode/extensions.json

# Local tooling caches
.turbo
.eslintcache
