# =============================================================================================
# Company Internal Chat — environment configuration template
# =============================================================================================
#
# Copy to `.env` and fill in real values for your machine:
#
#     cp .env.example .env          (macOS/Linux)
#     Copy-Item .env.example .env   (Windows PowerShell)
#
# `.env` is git-ignored and MUST NEVER be committed. This file contains PLACEHOLDERS ONLY —
# never put real credentials, passwords, hostnames or company IP addresses in it
# (CLAUDE.md §7, §15).
#
# The application starts with none of these set: every Phase 1 variable has a safe default.
# Variables marked "not read yet" are documented here so the full configuration surface is
# visible, but are not parsed by lib/config/env.ts until the phase noted against them.
# =============================================================================================


# ---------------------------------------------------------------------------------------------
# Application — used in Phase 1
# ---------------------------------------------------------------------------------------------

# development | production | test
NODE_ENV=development

# Port the Node process listens on.
PORT=3000

# Interface to bind.
#
#   Development:  127.0.0.1  — loopback only, nothing on the network can reach it.
#   Production:   0.0.0.0    — or the server's own LAN address, so employee computers can.
#
# Changing this to 0.0.0.0 is what exposes the application to the network, and ALLOWED_NETWORKS
# below is then the thing deciding who on that network may use it. Set both together, or the
# server either refuses everyone or is reachable by everyone who can route to it.
#
# If a reverse proxy is introduced later (Phase 10), this goes back to 127.0.0.1 and the proxy
# becomes the only thing that reaches the application directly.
BIND_HOST=127.0.0.1

# The origin employees use in the browser. Used for CSRF/Origin checks from Phase 5.
APP_URL=http://localhost:3000

# debug | info | warn | error
LOG_LEVEL=debug

# Next.js collects anonymous usage telemetry by default. This is a private company system, so it
# is switched off here. (To disable it machine-wide instead: npx next telemetry disable)
NEXT_TELEMETRY_DISABLED=1


# ---------------------------------------------------------------------------------------------
# Database — read from Phase 3 onwards (optional: the application still starts without it)
# ---------------------------------------------------------------------------------------------
#
# `company_chat_db` ALREADY EXISTS on the PostgreSQL 16 server and is the only database this
# project ever touches. It is never created, dropped, renamed, recreated or reset, and every
# other database on that server is off-limits (docs/02-database.md §0). The application refuses
# to start if this URL names any other database — see lib/db/target.ts.
#
# Use the dedicated, non-superuser application role (`company_chat_app`) — never a superuser or
# admin account. The role needs, on company_chat_db only:
#
#     GRANT CONNECT ON DATABASE company_chat_db TO company_chat_app;   -- already granted
#     GRANT USAGE, CREATE ON SCHEMA public TO company_chat_app;        -- needed for migrations
#
# PLACEHOLDER ONLY. Put real values in `.env`, which is git-ignored, and never in this file.
# `%` and other reserved characters in a password must be percent-encoded.
DATABASE_URL=postgresql://company_chat_app:PASSWORD@localhost:5432/company_chat_db


# ---------------------------------------------------------------------------------------------
# Identity & sessions — read from Phase 4 onwards
# ---------------------------------------------------------------------------------------------

# Idle session lifetime in hours, renewed while the user is active (D-04).
SESSION_TTL_HOURS=24

# Long-lived device identity lifetime in days (D-13). This is a convenience mechanism that
# reattaches a browser to the computer's assigned employee after a session expires — it is NOT
# authentication.
DEVICE_ID_TTL_DAYS=90


# ---------------------------------------------------------------------------------------------
# Administration — device assignment
# ---------------------------------------------------------------------------------------------
#
# Identity is assigned by an administrator to a company computer; employees cannot create, change
# or clear their own (docs/12-admin-device-identity.md). ADMIN_TOKEN is what guards that
# assignment surface at /admin and /api/admin.
#
# WITHOUT IT THE ADMIN SURFACE IS CLOSED, not open: every admin request is refused with 503. That
# is the safe default, and it also means no computer can be assigned until a token is set.
#
# Generate a long random value and put it in `.env` only — never here, and never in Git:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# LIMITATIONS, stated rather than implied. This is one shared secret, so actions cannot be
# attributed to an individual administrator; there is no rate limiting in front of it (Phase 9);
# and it does not restrict which network /admin can be reached from (Phase 8). Rotating this
# value immediately invalidates every administrator session.
#
# PLACEHOLDER ONLY — at least 24 characters.
ADMIN_TOKEN=CHANGE_ME_GENERATE_A_LONG_RANDOM_VALUE

# How long an unredeemed computer setup code stays usable, in hours.
ENROLLMENT_TTL_HOURS=24


# ---------------------------------------------------------------------------------------------
# File storage — read from Phase 7 onwards
# ---------------------------------------------------------------------------------------------

# Where uploaded files are kept. A relative path is resolved against the working directory; what
# the application stores is always absolute.
#
# It must be outside `public/` — the application refuses to start otherwise, because a storage
# root inside the statically served directory would publish every file in it. It must also contain
# no application code, and nothing in this application ever maps a URL onto it: downloads go
# through /api/attachments/:id/download, which checks membership on every request (CLAUDE.md §11).
#
#   Windows example: C:\company-chat\uploads
#   Linux example:   /var/lib/company-chat/uploads
#
# The default below is git-ignored. See docs/14-phase-7-file-transfer.md §13 for production setup.
UPLOAD_DIR=./var/uploads

# Maximum upload size in bytes. 524288000 = 500 MB (D-05).
#
# Enforced while the bytes are arriving, so an oversized upload is aborted rather than written and
# then rejected. Raise it for larger media; the application refuses a value above 8 GB, which
# catches a stray zero rather than expressing a policy.
MAX_FILE_SIZE=524288000

# ALLOWED_FILE_EXTENSIONS is deliberately NOT implemented.
#
# The company transfers arbitrary business files — video, archives, exports, CAD, source, and
# formats nobody has heard of — and an allowlist would block ordinary work while stopping nothing:
# an extension is a string the sender chose, so it is not a security control. Uploads are treated
# as opaque bytes. Safety comes from never executing them, never serving them inline, generating
# the storage name server-side, and authorizing every download
# (docs/14-phase-7-file-transfer.md §7).


# ---------------------------------------------------------------------------------------------
# Network restriction — read from Phase 8 onwards
# ---------------------------------------------------------------------------------------------
#
# Never hard-code the company's real network details in this file. These are placeholders; the
# real values belong in the production `.env` only (docs/16-phase-8-network-restriction.md).
#
# WHAT THIS IS. Every request is checked against these ranges before Next.js sees it, and every
# Socket.IO handshake is checked before a socket exists. It covers the whole application at once:
# pages, /admin, /setup, the REST API, attachment upload and attachment download. There is no
# per-route list to keep in step and no way to add a route that forgets it.

# Comma-separated addresses and CIDR ranges permitted to reach the application.
#
# Accepted forms:
#     192.168.1.0/24      an IPv4 range
#     10.0.0.5            a single IPv4 address (same as /32)
#     ::1                 a single IPv6 address
#     fd00::/8            an IPv6 range
#
# Host bits must be zero: write 192.168.1.0/24, not 192.168.1.5/24. The two differ by 255
# machines, so the application refuses the ambiguous form at startup rather than picking one.
#
# IN PRODUCTION THIS IS REQUIRED. With NODE_ENV=production and no value here, the process refuses
# to start — the setting that decides who can read the company's conversations must not be one
# that can be forgotten.
#
# UNSET OUTSIDE PRODUCTION it defaults to loopback only (127.0.0.0/8 and ::1), so `npm run dev`
# works with no configuration at all. Note the direction: the development default is the
# TIGHTEST policy, not a relaxation, so mislabelling a server's NODE_ENV can only lock people
# out — never let outsiders in.
#
# The line below is the development default written out. For production, replace it with the
# company's own ranges, e.g. ALLOWED_NETWORKS=192.168.1.0/24 — and include 127.0.0.1/32 as well
# if anything on the server itself (a health check, a monitor) needs to reach the application.
ALLOWED_NETWORKS=127.0.0.0/8,::1/128

# Peers whose X-Forwarded-For header is believed.
#
# LEAVE THIS UNSET unless the application is genuinely behind a reverse proxy. Unset means
# forwarding headers are ignored completely and the decision is made on the socket's real peer
# address, which is the correct behaviour for the V1 deployment where employees connect to this
# process directly.
#
# Setting it is opt-in and per-peer: X-Forwarded-For is read ONLY when the immediate peer is
# itself listed here, and the entries are then walked right-to-left, discarding addresses in this
# list, to find the client. Trusting the header without this would turn ALLOWED_NETWORKS into a
# value the client supplies — a header, not an allow-list.
#
# If you set it, configure the proxy to overwrite rather than append X-Forwarded-For.
# TRUSTED_PROXY_IPS=127.0.0.1

# ---------------------------------------------------------------------------------------------
# Windows desktop client (docs/18-desktop-client.md)
# ---------------------------------------------------------------------------------------------

# Where "Rising Path Recruiters Chat.exe" connects.
#
# THIS IS NOT A SERVER SETTING. The company server ignores it entirely — it is read by the
# desktop client's own process on the employee's machine, and it is listed here because this is
# where the project documents its environment variables.
#
# Development: set it before `npm run desktop:dev`, e.g. to this machine's LAN address so a second
# computer can be tested against it. Unset, the client falls back to http://localhost:3000, which
# is wrong everywhere except a developer's own machine — deliberately, so a misconfigured client
# fails visibly rather than connecting somewhere unintended. No company address is ever compiled
# into the build.
#
# Packaged production: an administrator does NOT set an environment variable. The address goes in
# server.json in the Electron user-data directory instead, so that upgrading the client does not
# disturb it and one installer serves every site:
#
#   %APPDATA%\Rising Path Recruiters Chat\server.json
#   { "serverUrl": "https://chat.risingpath.local", "launchAtStartup": false }
#
# Only http:// and https:// are accepted, and a URL carrying a username or password is refused.
# Production should use HTTPS; there is no certificate bypass anywhere in the client.
# DESKTOP_SERVER_URL=http://192.168.1.10:3000
