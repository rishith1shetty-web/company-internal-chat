# =============================================================================================
# Company Internal Chat — environment configuration template
# =============================================================================================
#
# Copy to `.env` and fill in real values for your machine:
#
#     cp .env.example .env          (macOS/Linux)
#     Copy-Item .env.example .env   (Windows PowerShell)
#
# `.env` is git-ignored and MUST NEVER be committed. This file contains PLACEHOLDERS ONLY —
# never put real credentials, passwords, hostnames or company IP addresses in it
# (CLAUDE.md §7, §15).
#
# The application starts with none of these set: every Phase 1 variable has a safe default.
# Variables marked "not read yet" are documented here so the full configuration surface is
# visible, but are not parsed by lib/config/env.ts until the phase noted against them.
# =============================================================================================


# ---------------------------------------------------------------------------------------------
# Application — used in Phase 1
# ---------------------------------------------------------------------------------------------

# development | production | test
NODE_ENV=development

# Port the Node process listens on.
PORT=3000

# Interface to bind. Keep this on loopback in production: the reverse proxy is the only thing
# that should reach the application directly (docs/03-network.md).
BIND_HOST=127.0.0.1

# The origin employees use in the browser. Used for CSRF/Origin checks from Phase 5.
APP_URL=http://localhost:3000

# debug | info | warn | error
LOG_LEVEL=debug

# Next.js collects anonymous usage telemetry by default. This is a private company system, so it
# is switched off here. (To disable it machine-wide instead: npx next telemetry disable)
NEXT_TELEMETRY_DISABLED=1


# ---------------------------------------------------------------------------------------------
# Database — read from Phase 3 onwards (optional: the application still starts without it)
# ---------------------------------------------------------------------------------------------
#
# `company_chat_db` ALREADY EXISTS on the PostgreSQL 16 server and is the only database this
# project ever touches. It is never created, dropped, renamed, recreated or reset, and every
# other database on that server is off-limits (docs/02-database.md §0). The application refuses
# to start if this URL names any other database — see lib/db/target.ts.
#
# Use the dedicated, non-superuser application role (`company_chat_app`) — never a superuser or
# admin account. The role needs, on company_chat_db only:
#
#     GRANT CONNECT ON DATABASE company_chat_db TO company_chat_app;   -- already granted
#     GRANT USAGE, CREATE ON SCHEMA public TO company_chat_app;        -- needed for migrations
#
# PLACEHOLDER ONLY. Put real values in `.env`, which is git-ignored, and never in this file.
# `%` and other reserved characters in a password must be percent-encoded.
DATABASE_URL=postgresql://company_chat_app:PASSWORD@localhost:5432/company_chat_db


# ---------------------------------------------------------------------------------------------
# Identity & sessions — NOT read yet (added in Phase 5)
# ---------------------------------------------------------------------------------------------

# Idle session lifetime in hours, renewed while the user is active (D-04).
SESSION_TTL_HOURS=24

# Long-lived device identity lifetime in days (D-13). This is a convenience mechanism that
# reattaches a browser to the same user after a session expires — it is NOT authentication.
DEVICE_ID_TTL_DAYS=90


# ---------------------------------------------------------------------------------------------
# File storage — NOT read yet (added in Phase 7)
# ---------------------------------------------------------------------------------------------

# Absolute path to file storage. Must be outside the repository and outside `public/`, and must
# contain no application code (CLAUDE.md §11).
#   Windows example: C:\company-chat\uploads
#   Linux example:   /var/lib/company-chat/uploads
UPLOAD_DIR=./var/uploads

# Maximum upload size in bytes. 524288000 = 500 MB (D-05).
MAX_FILE_SIZE=524288000

# Permitted upload extensions.
ALLOWED_FILE_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,jpg,jpeg,png,txt,zip


# ---------------------------------------------------------------------------------------------
# Network restriction — NOT read yet (added in Phase 8)
# ---------------------------------------------------------------------------------------------
#
# Never hard-code the company's real network details in this file. These are placeholders; the
# real values belong in the production `.env` only (docs/03-network.md).

# Comma-separated CIDR ranges permitted to reach the application.
ALLOWED_NETWORKS=127.0.0.1/32

# Peers whose X-Forwarded-For header is believed. Anything not listed here is ignored — an
# unvalidated forwarding header is a client-controlled value.
TRUSTED_PROXY_IPS=127.0.0.1
